# Virtual environment
venv/
env/
.venv/

# Environment variables / secrets
.env

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/

# Test/lint/type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local wearable data and databases must never be committed.
data/**
!data/.gitkeep

# dbt build artifacts
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Dagster local dev instance state
.dagster_home/
.tmp_dagster_home_*/

# Local MLflow registry, artifacts, and synthetic modeling output
.modeling/
mlruns/
mlflow.db*

# Local databases and sidecars (fixtures belong in text formats, not database files).
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.duckdb
*.duckdb.*

# Private working notes; keep durable instructions in SETUP.md and docs/.
/.session-notes/
# Catch accidental root-level reports as well as the archived copies.
/SESSION_*.md
/QA_REPORT*.md
/RECONCILIATION_REPORT*.md
/NEXT_STEPS_FOR_HUMAN.md
/*_SUMMARY.md
/*_REPORT.md
/*_REPORT_*.md
