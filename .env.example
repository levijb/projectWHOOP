# Replace placeholders locally only. Never commit the populated .env file.
WHOOP_CLIENT_ID=<your-whoop-client-id>
WHOOP_CLIENT_SECRET=<your-whoop-client-secret>
WHOOP_ACCESS_TOKEN=<your-whoop-access-token>
WHOOP_REFRESH_TOKEN=<your-whoop-refresh-token>

# Only a human should enable these. Merely setting credentials never selects live resources.
WHOOP_PIPELINE_USE_LIVE_CLIENT=false
WHOOP_PIPELINE_USE_POSTGRES=false
# Use a PostgreSQL connection string, not the Supabase project/API URL. URL-encode passwords.
DATABASE_URL=postgresql://user:password@db.example.invalid:5432/postgres?sslmode=require
